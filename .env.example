# Токен от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-DEF...

# Через запятую ID пользователей, которым разрешён доступ. Пусто = доступ у всех.
ALLOWED_USERS=

# Сколько скачиваний одновременно
MAX_CONCURRENT_DOWNLOADS=3

# Файл cookies в формате Netscape (нужен для Instagram/Facebook/18+ YouTube). Необязательно.
COOKIES_FILE=

# Адрес локального Telegram Bot API сервера (снимает лимит 50 МБ -> 2 ГБ). Необязательно.
# Пример: http://localhost:8081
TELEGRAM_API_URL=
